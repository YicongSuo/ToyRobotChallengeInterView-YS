{
  "compilerOptions": {
    /* env */
    "target": "ES2020",
    "lib": ["ES2020"],
    
    /* module */
    "module": "commonjs",
    "rootDir": "./",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    
    /* output */
    "outDir": "./dist",
    "removeComments": true,
    "sourceMap": true,
    
    /* class check */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    
    /* Interoperability */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "*.ts"
, "file-runner.ts", "utils/readline.ts", "utils/robot-game.ts", "types/types.ts", "constants/constants.ts", "utils/command-parser.ts"  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}